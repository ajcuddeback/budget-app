{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(mvn *)",
      "Bash(./mvnw *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(ng *)",
      "Bash(node *)",
      "Bash(java *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(tools/*)",
      "Bash(./tools/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git push -u origin *)",
      "Edit(backend/**)",
      "Edit(frontend/**)",
      "Edit(docs/**)",
      "Edit(tools/**)",
      "Bash(tools/ui-check.sh*)",
      "Bash(npx playwright*)",
      "Bash(npx tsc*)",
      "Bash(npx tsx*)",
      "Edit(tools/ui/**)",
      "Bash(curl -fsS*)"
    ],
    "deny": [
      "Edit(client/**)",
      "Edit(server/**)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa*)",
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "ask": [
      "Bash(docker *)",
      "Bash(psql *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-write.sh",
            "timeout": 15,
            "statusMessage": "Checking for secrets and legacy paths..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-changed.sh",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
