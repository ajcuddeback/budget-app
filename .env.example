# Copy to .env and set DB_PASSWORD. Nothing else is required.
#
# .env is gitignored and holds a real credential — do not commit it, and do not paste its
# contents into a bug report.

# Required. Generate one you will not reuse anywhere else, e.g.
#   openssl rand -base64 32
DB_PASSWORD=

# Optional. The defaults are fine for a single household on one machine.
#DB_NAME=budgetowl
#DB_USER=budgetowl

# Which address the web app is reachable on. 127.0.0.1 means "this machine only" — the safe
# default. Use 0.0.0.0 to reach it from elsewhere on your LAN, and put TLS in front of it
# before you do.
#BIND_ADDRESS=127.0.0.1
#WEB_PORT=8080

# Pin a release instead of tracking latest.
#BUDGET_OWL_VERSION=0.1.0
